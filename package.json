{
  "name": "lia-sync",
  "version": "3.7.0",
  "description": "Lia Sync - Runtime Persistente de Agente, Aprendizado Contínuo, Autonomia Operacional e Copiloto via WhatsApp",
  "author": "Lia Sync",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev-preview.mjs",
    "start": "node src/server.mjs",
    "build": "node scripts/build-dist.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "lint:eslint": "eslint . --max-warnings=0",
    "test": "node --import ./scripts/test-setup.mjs --test",
    "test:coverage": "node --import ./scripts/test-setup.mjs --test --experimental-test-coverage",
    "test:contract": "node scripts/contract-check.mjs",
    "eval:naturalness": "node scripts/eval-naturalness.mjs",
    "backup:data": "node scripts/backup-data.mjs"
  },
  "dependencies": {
    "@pdfme/generator": "^6.2.8",
    "@pdfme/schemas": "^6.2.8",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0"
  }
}
