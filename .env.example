PORT=3000
HOST=0.0.0.0
TZ=America/Fortaleza
# Imagem Docker e tag para deploy/rollback determinístico (opcional; padrão ghcr.io/atualyze/lia-sync:latest)
# LIA_BOT_IMAGE=ghcr.io/atualyze/lia-sync
# LIA_BOT_TAG=latest
# WhatsApp nativo: Baileys é o provedor padrão da Lia.
WHATSAPP_PROVIDER=baileys
BAILEYS_AUTH_DIR=./data/baileys-auth
WEBHOOK_TOKEN=
# Provedor legado opcional (somente se decidir usar Evolution explicitamente):
# WHATSAPP_PROVIDER=evolution
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# EVOLUTION_INSTANCE=
ALLOW_INSECURE_WEBHOOK=false
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=1024
GEMINI_API_KEY=
GEMINI_THINKING_BUDGET=0
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Lia Sync
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_ACCESS_TOKEN=
# Somente development/teste; nunca habilite mock em produção.
GOOGLE_CALENDAR_MOCK=false
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RUNTIME_ENABLED=true
# Widget Turnstile compartilhado: autorize os hostnames no Cloudflare.
SUPABASE_CAPTCHA_PROVIDER=turnstile
SUPABASE_CAPTCHA_SITE_KEY=
FAQ_URL=
FAQ_CACHE_SECONDS=60
DATA_FILE=./data/sessions.json
MAX_HISTORY_MESSAGES=12
MAX_INPUT_CHARS=2000
MESSAGE_DEBOUNCE_MS=1200
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MIN=10
SESSION_TTL_DAYS=30
HANDOFF_REMINDER_MINUTES=15
HUMAN_AUTO_RESUME_HOURS=0
HUMAN_ALLOW_CLIENT_RESUME=true
BUSINESS_TIME_ZONE=America/Fortaleza
INACTIVITY_CHECK_SECONDS=30
INACTIVITY_STALE_HOURS=12
ALLOW_UNAUTHENTICATED_DASHBOARD=false
DASHBOARD_ORIGIN=
DASHBOARD_ALLOWED_ROLES=
# Fallback local da fila do Copiloto; use somente com uma réplica e de forma explícita.
COPILOT_TASK_LOCAL_FALLBACK=false
